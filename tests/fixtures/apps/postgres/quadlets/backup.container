# No [Install] section: this container runs when the timer says so, not at boot.
# No RemainAfterExit either, or only the first trigger would do anything.
[Unit]
Requires=main.service
After=main.service

[Container]
Image=docker.io/library/postgres:{{ postgres_version }}
Network=app.network
Volume=dumps.volume:/dumps
Environment=PGHOST={{ quadlet_app_name }}--main
Environment=PGPASSWORD={{ lookup('passwordstore', 'test/postgres/superuser') }}
Exec=/usr/bin/pg_dumpall -U postgres -f /dumps/dump.sql

[Service]
Type=oneshot

[Unit]
Description=PostgreSQL

[Container]
Image=docker.io/library/postgres:{{ postgres_version }}
Network=app.network
Volume=data.volume:/var/lib/postgresql/data
Volume=%init%:/docker-entrypoint-initdb.d
Environment=POSTGRES_PASSWORD={{ lookup('passwordstore', 'test/postgres/superuser') }}

[Service]
Restart=always

[Install]
WantedBy=multi-user.target

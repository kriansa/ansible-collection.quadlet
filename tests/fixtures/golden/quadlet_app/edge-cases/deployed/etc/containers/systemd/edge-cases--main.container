# Unusual but valid input, kept here so the goldens show exactly what the module does with it.
# This comment sits above the first section header, and stays there.
[Unit]
Description=Edge cases
# Each unit of a list gets the app prefix if the app defines it: db.service and the service
# podman generates from main.network do, cache.service does not
After=edge-cases--db.service edge-cases--main-network.service cache.service
After=network-online.target
# A host unit, left as written
Wants=sshd.service
# Written with a trailing slash, so the storage dependency is added a second time
RequiresMountsFor=/var/lib/containers/storage/
RequiresMountsFor=/var/lib/containers/storage
Requires=edge-cases--data-volume-init.service
After=edge-cases--data-volume-init.service

[Container]
ContainerName=custom-name
Image=docker.io/library/alpine:latest
Network=host
Volume=edge-cases--data.volume:/data:ro
Volume=/srv/edge-cases/config/main/a.conf:/etc/a.conf:rw
Volume=/srv/edge-cases/init/main/sub:/init:ro,Z,idmap
Volume=/srv/shared:/shared
Exec=/bin/sh -c 'trap "exit 0" TERM; while :; do sleep 1; done'
# Default from quadlet_app. Set UserNS= explicitly to override; UserNS=host is what a
# container needs if it reads the host journal or other processes' /proc entries.
UserNS=auto:size=65536

[Service]
Restart=on-failure

{
  "calls": [
    {
      "argv": [
        "systemctl",
        "is-active",
        "agent--main.service"
      ],
      "timeout": 10
    },
    {
      "argv": [
        "/usr/lib/systemd/system-generators/podman-system-generator",
        "-dryrun",
        "-v"
      ],
      "timeout": 30
    },
    {
      "argv": [
        "systemctl",
        "daemon-reload"
      ],
      "timeout": 120
    },
    {
      "argv": [
        "systemctl",
        "show",
        "-p",
        "Id,Type,ActiveState,SubState,InvocationID",
        "agent--gpu-exporter.service",
        "agent--main.service",
        "agent--probe.service"
      ],
      "timeout": 10
    },
    {
      "argv": [
        "systemctl",
        "list-dependencies",
        "--all",
        "--type",
        "service",
        "agent--main.service"
      ],
      "timeout": 10
    },
    {
      "argv": [
        "systemctl",
        "restart",
        "agent--state-volume-init.service",
        "agent--main.service"
      ],
      "timeout": 120
    },
    {
      "argv": [
        "systemctl",
        "show",
        "-p",
        "Id,Type,ActiveState,SubState,InvocationID",
        "agent--gpu-exporter.service",
        "agent--main.service",
        "agent--probe.service"
      ],
      "timeout": 10
    },
    {
      "argv": [
        "systemctl",
        "show",
        "-p",
        "Id,Type,ActiveState,SubState,InvocationID",
        "agent--main.service"
      ],
      "timeout": 10
    }
  ],
  "exit": {
    "application_name": "agent",
    "changed": true,
    "msg": "quadlet files deployed and service started",
    "quadlet_files": [
      "agent--gpu-exporter.container",
      "agent--main.container",
      "agent--probe.container",
      "agent--state.volume",
      "agent--state-volume-init.container"
    ],
    "service_name": "agent--main.service",
    "unit_files": []
  },
  "failure": null
}

# Generated by kriansa.commons.quadlet_app - do not edit
[Unit]
Description=Ownership bootstrap for postgres--data
ConditionPathExists=!/var/lib/quadlet-app/postgres--data.999_999.done

[Container]
ContainerName=postgres--data-volume-init
Image=docker.io/library/alpine:3.24
Volume=postgres--data.volume:/target:rw,z
Exec=/bin/sh -c 'find /target -mindepth 1 -print0 | xargs -0r chown -h 999:999; chown 999:999 /target'

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=1800
ExecStartPost=/usr/bin/touch /var/lib/quadlet-app/postgres--data.999_999.done

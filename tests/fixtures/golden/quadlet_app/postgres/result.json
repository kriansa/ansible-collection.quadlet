{
  "calls": [
    {
      "argv": [
        "systemctl",
        "is-enabled",
        "postgres--backup.timer"
      ],
      "timeout": 10
    },
    {
      "argv": [
        "/usr/lib/systemd/system-generators/podman-system-generator",
        "-dryrun",
        "-v"
      ],
      "timeout": 30
    },
    {
      "argv": [
        "systemctl",
        "daemon-reload"
      ],
      "timeout": 300
    },
    {
      "argv": [
        "systemctl",
        "show",
        "-p",
        "LoadState",
        "postgres--main.service"
      ],
      "timeout": 10
    },
    {
      "argv": [
        "systemctl",
        "list-dependencies",
        "--all",
        "--type",
        "service",
        "postgres--main.service"
      ],
      "timeout": 10
    },
    {
      "argv": [
        "systemctl",
        "is-enabled",
        "postgres--backup.timer"
      ],
      "timeout": 10
    },
    {
      "argv": [
        "systemctl",
        "enable",
        "postgres--backup.timer"
      ],
      "timeout": 300
    },
    {
      "argv": [
        "systemctl",
        "restart",
        "postgres--backup.timer"
      ],
      "timeout": 300
    },
    {
      "argv": [
        "systemctl",
        "show",
        "-p",
        "Id,Type,ActiveState,SubState,InvocationID",
        "postgres--backup.service",
        "postgres--main.service"
      ],
      "timeout": 10
    },
    {
      "argv": [
        "podman",
        "network",
        "exists",
        "postgres--app"
      ],
      "timeout": 30
    },
    {
      "argv": [
        "systemctl",
        "restart",
        "postgres--data-volume-init.service",
        "postgres--dumps-volume-init.service",
        "postgres--main.service"
      ],
      "timeout": 300
    },
    {
      "argv": [
        "systemctl",
        "show",
        "-p",
        "Id,Type,ActiveState,SubState,InvocationID",
        "postgres--backup.service",
        "postgres--main.service"
      ],
      "timeout": 10
    },
    {
      "argv": [
        "systemctl",
        "show",
        "-p",
        "Id,Type,ActiveState,SubState,InvocationID",
        "postgres--main.service"
      ],
      "timeout": 10
    }
  ],
  "exit": {
    "application_name": "postgres",
    "changed": true,
    "msg": "quadlet files deployed and service started",
    "quadlet_files": [
      "postgres--app.network",
      "postgres--backup.container",
      "postgres--data.volume",
      "postgres--dumps.volume",
      "postgres--main.container",
      "postgres--data-volume-init.container",
      "postgres--dumps-volume-init.container"
    ],
    "service_name": "postgres--main.service",
    "unit_files": [
      "postgres--backup.timer"
    ]
  },
  "failure": null
}

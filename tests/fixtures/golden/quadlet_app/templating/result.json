{
  "calls": [
    {
      "argv": [
        "systemctl",
        "is-active",
        "templating--main.service"
      ],
      "timeout": 10
    },
    {
      "argv": [
        "systemctl",
        "is-active",
        "templating--main.service"
      ],
      "timeout": 10
    },
    {
      "argv": [
        "/usr/lib/systemd/system-generators/podman-system-generator",
        "-dryrun",
        "-v"
      ],
      "timeout": 30
    },
    {
      "argv": [
        "systemctl",
        "daemon-reload"
      ],
      "timeout": 120
    },
    {
      "argv": [
        "systemctl",
        "is-active",
        "templating--main.service"
      ],
      "timeout": 10
    },
    {
      "argv": [
        "systemctl",
        "start",
        "templating--main.service"
      ],
      "timeout": 120
    }
  ],
  "exit": {
    "application_name": "templating",
    "changed": true,
    "msg": "quadlet files deployed and service started",
    "quadlet_files": [
      "templating--main.container"
    ],
    "service_name": "templating--main.service",
    "unit_files": []
  },
  "failure": null
}

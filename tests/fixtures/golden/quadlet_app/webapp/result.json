{
  "calls": [
    {
      "argv": [
        "systemctl",
        "is-active",
        "webapp--main.service"
      ],
      "timeout": 10
    },
    {
      "argv": [
        "systemctl",
        "is-active",
        "webapp--main.service"
      ],
      "timeout": 10
    },
    {
      "argv": [
        "/usr/lib/systemd/system-generators/podman-system-generator",
        "-dryrun",
        "-v"
      ],
      "timeout": 30
    },
    {
      "argv": [
        "systemctl",
        "daemon-reload"
      ],
      "timeout": 120
    },
    {
      "argv": [
        "systemctl",
        "restart",
        "webapp--cache-volume-init.service"
      ],
      "timeout": 120
    },
    {
      "argv": [
        "systemctl",
        "is-active",
        "webapp--main.service"
      ],
      "timeout": 10
    },
    {
      "argv": [
        "systemctl",
        "start",
        "webapp--main.service"
      ],
      "timeout": 120
    }
  ],
  "exit": {
    "application_name": "webapp",
    "changed": true,
    "msg": "quadlet files deployed and service started",
    "quadlet_files": [
      "webapp--api.container",
      "webapp--app.network",
      "webapp--cache.volume",
      "webapp--main.container",
      "webapp--worker.container",
      "webapp--cache-volume-init.container"
    ],
    "service_name": "webapp--main.service",
    "unit_files": []
  },
  "failure": null
}

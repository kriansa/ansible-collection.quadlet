{
  "calls": [
    {
      "argv": [
        "systemctl",
        "is-active",
        "webapp--main.service"
      ],
      "timeout": 10
    },
    {
      "argv": [
        "/usr/lib/systemd/system-generators/podman-system-generator",
        "-dryrun",
        "-v"
      ],
      "timeout": 30
    },
    {
      "argv": [
        "systemctl",
        "daemon-reload"
      ],
      "timeout": 300
    },
    {
      "argv": [
        "systemctl",
        "show",
        "-p",
        "LoadState",
        "webapp--main.service"
      ],
      "timeout": 10
    },
    {
      "argv": [
        "systemctl",
        "list-dependencies",
        "--all",
        "--type",
        "service",
        "webapp--main.service"
      ],
      "timeout": 10
    },
    {
      "argv": [
        "systemctl",
        "show",
        "-p",
        "Id,Type,ActiveState,SubState,InvocationID",
        "webapp--api.service",
        "webapp--main.service",
        "webapp--worker.service"
      ],
      "timeout": 10
    },
    {
      "argv": [
        "podman",
        "network",
        "exists",
        "webapp--app"
      ],
      "timeout": 30
    },
    {
      "argv": [
        "systemctl",
        "restart",
        "webapp--cache-volume-init.service",
        "webapp--main.service"
      ],
      "timeout": 300
    },
    {
      "argv": [
        "systemctl",
        "show",
        "-p",
        "Id,Type,ActiveState,SubState,InvocationID",
        "webapp--api.service",
        "webapp--main.service",
        "webapp--worker.service"
      ],
      "timeout": 10
    },
    {
      "argv": [
        "systemctl",
        "show",
        "-p",
        "Id,Type,ActiveState,SubState,InvocationID",
        "webapp--main.service"
      ],
      "timeout": 10
    }
  ],
  "exit": {
    "application_name": "webapp",
    "changed": true,
    "msg": "quadlet files deployed and service started",
    "quadlet_files": [
      "webapp--api.container",
      "webapp--app.network",
      "webapp--cache.volume",
      "webapp--main.container",
      "webapp--worker.container",
      "webapp--cache-volume-init.container"
    ],
    "service_name": "webapp--main.service",
    "unit_files": []
  },
  "failure": null
}

# Generated by kriansa.commons.quadlet_app - do not edit
[Unit]
Description=Ownership bootstrap for webapp--cache
ConditionPathExists=!/var/lib/quadlet-app/webapp--cache.0_0.done

[Container]
ContainerName=webapp--cache-volume-init
Image=docker.io/library/alpine:3.24
Volume=webapp--cache.volume:/target:rw,z
Exec=/bin/sh -c 'find /target -mindepth 1 -print0 | xargs -0r chown -h 0:0; chown 0:0 /target'

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=1800
ExecStartPost=/usr/bin/touch /var/lib/quadlet-app/webapp--cache.0_0.done
